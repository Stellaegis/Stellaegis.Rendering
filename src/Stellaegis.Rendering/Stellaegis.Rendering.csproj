<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Rendering</RootNamespace>
    <PackageId>Stellaegis.Rendering</PackageId>
    <Description>Stellaegis rendering: a template and its JSON data rendered to HTML or to PDF, in process or on a remote host behind the same port. Engines come in their own packages.</Description>
    <PackageTags>stellaegis;rendering;template;html;pdf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Stellaegis.Primitives" />
  </ItemGroup>

</Project>
