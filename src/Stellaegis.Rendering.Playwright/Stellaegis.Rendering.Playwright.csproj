<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Rendering.Playwright</RootNamespace>
    <PackageId>Stellaegis.Rendering.Playwright</PackageId>
    <Description>Stellaegis rendering PDF engine: prints HTML to PDF with Playwright (Chromium headless). Requires Chromium installed on the host.</Description>
    <PackageTags>stellaegis;rendering;html;pdf;playwright;chromium</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\Stellaegis.Rendering\Stellaegis.Rendering.csproj" />
  </ItemGroup>

</Project>
