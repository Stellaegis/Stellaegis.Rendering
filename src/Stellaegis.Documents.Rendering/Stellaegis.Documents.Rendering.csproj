<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Documents.Rendering</RootNamespace>
    <PackageId>Stellaegis.Documents.Rendering</PackageId>
    <Description>Stellaegis document rendering: HTML via Scriban templates, PDF via Playwright (Chromium headless).</Description>
    <PackageTags>stellaegis;documents;pdf;html;scriban;playwright;rendering</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
